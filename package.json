{
  "name": "pramonelt",
  "description": "Pramone.lt website",
  "homepage": "https://github.com/kaunoregionopramone/pramone-lt",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "import-sample-data": "cd studio && sanity dataset import sample-data.tar.gz --replace"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "devDependencies": {
    "npm-run-all": "4.1.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31",
      "sharp": "^0.35.5"
    },
    "@sanity/preview-url-secret": {
      "@sanity/uuid": "3.0.3"
    }
  }
}
