    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "6.2.5",
    "@sanity/icons": "5.2.3",
    "@sanity/vision": "6.20.0",
    "date-fns": "3.6.0",
    "pluralize-esm": "9.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "sanity": "6.20.0",
    "sanity-plugin-asset-source-unsplash": "7.0.30",
    "sanity-plugin-media": "6.5.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "prettier": "3.5",
    "typescript": "6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "engines": {
    "node": "24.x"
